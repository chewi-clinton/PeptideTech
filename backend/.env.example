SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres — supplied by the user for the VPS deployment; docker-compose sets
# this for local dev. Falls back to sqlite if unset.
DATABASE_URL=postgres://peptidetech:peptidetech@localhost:5432/peptidetech

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MinIO (S3-compatible). Left unset -> falls back to local filesystem storage.
# MINIO_ENDPOINT: internal address Django/boto3 uses to reach MinIO directly
#   (e.g. "http://minio:9000" on the Docker network, or the VPS's private
#   address). MINIO_PUBLIC_ENDPOINT: host:port a *browser* can reach (no
#   protocol) — used only to build the image URLs returned by the API. These
#   are often different; mixing them up makes every image URL 404.
MINIO_ENDPOINT=http://localhost:13002
MINIO_PUBLIC_ENDPOINT=localhost:13002
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=peptidetech
MINIO_USE_SSL=False

# Email — left unset -> falls back to console backend (prints to stdout).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=support@peptidetech.cc
ADMIN_ALERT_EMAIL=support@peptidetech.cc
SITE_URL=http://localhost:3000
